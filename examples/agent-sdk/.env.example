# Workspace + Agent (필수)
TEAMVER_WORKSPACE_ID=WS-
TEAMVER_AGENT_ID=AGT-

# Channel / Events / Jobs (tv_ak_*)
# API hosts below are optional — SDK defaults to production when unset:
#   CHANNEL → https://api.teamver.com
#   AGENT   → https://agent-api.teamver.com
#   MAIL    → https://mail-api.teamver.com
#TEAMVER_MAIN_API_BASE=https://api.teamver.com
TEAMVER_AGENT_TOKEN=tv_ak_
#TEAMVER_AGENT_API_BASE=https://agent-api.teamver.com

# Mail (tv_agent_*) — trailing /v1 없음
#TEAMVER_MAIL_API_BASE=https://mail-api.teamver.com
TEAMVER_MAIL_AGENT_TOKEN=tv_agent_

# 선택: run 시 채널에 테스트 메시지 게시 (비우면 list만)
TEAMVER_SMOKE_CHANNEL_ID=

# 선택: 메일 inbox status 필터 (기본 queued)
TEAMVER_MAIL_INBOX_STATUS=queued

# 단계 사이 sleep 초 (기본 2)
TEAMVER_STEP_SLEEP_SEC=2

# 디버그 (1/true 이면 도구 스키마 일부 출력)
TEAMVER_DEBUG=0
